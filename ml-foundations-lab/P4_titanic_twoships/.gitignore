# Downloaded raw datasets (regenerable via `python dataset.py --download`)
data/*.csv
data/*.csv.gz
data/*.zip
data/_cache/
!data/.gitkeep

# Generated figures (regenerable via `python train.py --plot ...`)
assets/calibration_*.png
assets/fairness_*.png
assets/roc_*.png
!assets/hero.png
!assets/.gitkeep
