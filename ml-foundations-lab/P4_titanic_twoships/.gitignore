# P4_titanic_twoships artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
.ipynb_checkpoints/

# Trained model artifacts (regenerable via `python train.py`)
models/*.joblib
models/*.json
models/*.txt
