# =============================================================================
# shared/plot_style.mplstyle
# -----------------------------------------------------------------------------
# Project-wide matplotlib theme for the `Machine-Learning` monorepo.
#
# Designed to give every chart in P1-P16 a consistent, publication-grade look
# across notebooks, CLI scripts, and automated reports (HTML/PDF).
#
# IMPORTANT (mplstyle quirk): the `#` character is the comment marker in this
# file format, so hex colors MUST be written WITHOUT the leading `#` (e.g.
# `2b2b2b` not `#2b2b2b`). Matplotlib still parses the bare hex correctly.
#
# Usage (from any project script):
#     import matplotlib.pyplot as plt
#     plt.style.use("/path/to/Machine-Learning/shared/plot_style.mplstyle")
#
# Or, if the repo root is on sys.path:
#     from shared import apply_style
#     apply_style()
# =============================================================================

# ---- Figure & DPI ------------------------------------------------------------
figure.figsize       : 10, 6
figure.dpi           : 100
figure.facecolor     : white
figure.autolayout    : False
figure.constrained_layout.use : True

# ---- Axes --------------------------------------------------------------------
axes.facecolor       : white
axes.edgecolor       : 2b2b2b
axes.linewidth       : 0.9
axes.grid            : True
axes.grid.axis       : both
axes.grid.which      : major
axes.titlesize       : 14
axes.titleweight     : bold
axes.titlecolor      : 1a1a1a
axes.titlepad        : 12.0
axes.labelsize       : 11
axes.labelweight     : normal
axes.labelcolor      : 2b2b2b
axes.axisbelow       : True
axes.spines.top      : False
axes.spines.right    : False
axes.xmargin         : 0.03
axes.ymargin         : 0.05

# ---- Grid --------------------------------------------------------------------
grid.color           : d9d9d9
grid.linestyle       : --
grid.linewidth       : 0.55
grid.alpha           : 0.85

# ---- Ticks -------------------------------------------------------------------
xtick.color          : 2b2b2b
ytick.color          : 2b2b2b
xtick.labelsize      : 10
ytick.labelsize      : 10
xtick.direction      : out
ytick.direction      : out
xtick.major.size     : 4
ytick.major.size     : 4
xtick.minor.size     : 2.5
ytick.minor.size     : 2.5
xtick.minor.visible  : True
ytick.minor.visible  : True

# ---- Lines & markers ---------------------------------------------------------
lines.linewidth      : 2.0
lines.markersize     : 6
lines.solid_capstyle : round

# ---- Legend ------------------------------------------------------------------
legend.frameon       : False
legend.fontsize      : 10
legend.labelspacing  : 0.4
legend.handlelength  : 1.6
legend.borderaxespad : 0.5

# ---- Font (sans-serif first, falls back to CJK + emoji glyphs) --------------
font.family          : sans-serif
font.sans-serif      : Inter, Helvetica Neue, Arial, Noto Sans SC, DejaVu Sans
font.size            : 11

# Unicode minus rendering (do not show ASCII hyphen as minus sign)
axes.unicode_minus   : False

# ---- Color cycle (Okabe-Ito-inspired, colorblind-safe) ----------------------
# Order chosen for high contrast against a white background and for clear
# separation in multi-line time-series / multi-class classification plots.
# NOTE: mplstyle parser does NOT support backslash line continuation; the
# cycler MUST live on a single physical line.
axes.prop_cycle      : cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9', 'F0E442', '000000'])

# ---- Saving ------------------------------------------------------------------
savefig.dpi          : 160
savefig.facecolor    : white
savefig.bbox         : standard
savefig.pad_inches   : 0.12
savefig.transparent  : False

# ---- Error bars & histograms -------------------------------------------------
errorbar.capsize     : 3.0
hist.bins            : auto

# ---- Patch (boxes, violins) --------------------------------------------------
patch.linewidth      : 0.9
patch.facecolor      : 0072B2
patch.edgecolor      : 2b2b2b
patch.force_edgecolor : True

# ---- Boxplot -----------------------------------------------------------------
boxplot.boxprops.linewidth       : 1.0
boxplot.whiskerprops.linewidth   : 1.0
boxplot.capprops.linewidth       : 1.0
boxplot.medianprops.linewidth    : 1.6
boxplot.medianprops.color        : D55E00
boxplot.flierprops.marker        : o
boxplot.flierprops.markersize    : 4
boxplot.flierprops.markerfacecolor : CC79A7
boxplot.flierprops.markeredgecolor : none

# ---- Image (imshow / heatmaps) ----------------------------------------------
image.cmap           : viridis
image.interpolation  : nearest

# ---- Contour -----------------------------------------------------------------
contour.negative_linestyle : dashed
